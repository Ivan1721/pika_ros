<?xml version="1.0"?>
<!--
  Pika Gripper URDF — modelo oficial de AgileX Robotics
  Mallas y medidas de pika_gripper_description, enviado por el soporte de AgileX el 20-10-2026
  (originales en pika_description/agilex/). Este macro los pasa al marco de este repositorio y
  conserva los nombres de links y joints que usan pika_sim y la teleop.

  Marco de coordenadas (gripper_base), el mismo que el link6 del Piper:
    Origen = cara de la brida (interfaz con link6)
    +Z : eje de la herramienta, hacia las puntas de las garras
    +Y : dirección en que se desplazan las garras
    −X : lado de las cámaras
  AgileX usa otro marco (X herramienta, Y garras, Z cámaras): el paso es
    x = −z_AgileX,  y = y_AgileX,  z = x_AgileX   (rpy 0 −π/2 0 en las mallas)

  Medidas (mallas de AgileX y plano de cámaras):
    Puntas de las garras:  z = 0,190 m desde la brida (el plano da 194,3 mm desde la base del montaje)
    Apertura:              0 a 94 mm entre las caras internas (cada garra 0 a 47 mm); el driver real
                           limita la apertura total a 98 mm
    Cámara D405:           46 mm sobre el eje de las garras, cara a 132 mm de las puntas; el marco va en
                           el imager izquierdo (línea base de 18 mm)
    Fisheye:               73,5 mm sobre el eje de las garras, lente a 122 mm de las puntas
    Ambas cámaras miran a lo largo de +Z (eje de la herramienta), según el plano de AgileX.
    TCP (pika_tcp):        entre las garras, a 0,180 m (1 cm detrás de las puntas)

  Masa: las inercias del CAD de AgileX suman 0,257 kg, pero el gripper pesa 617–690 g según las
  tiendas (con motor y cámaras). La base se escala a 0,55 kg (total 0,617 kg), con el centro de masa
  y la forma de la inercia del CAD.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="pika_gripper" params="prefix:='' parent origin_xyz:='0 0 0' origin_rpy:='0 0 0'">

    <xacro:property name="AGILEX" value="0 -1.5708 0"/>   <!-- rotación de las mallas de AgileX -->
    <xacro:property name="MALLAS" value="package://pika_description/meshes/agilex/gripper"/>

    <material name="${prefix}pika_dark">
      <color rgba="0.18 0.18 0.18 1.0"/>
    </material>
    <material name="${prefix}pika_mid">
      <color rgba="0.55 0.55 0.55 1.0"/>
    </material>

    <joint name="${prefix}pika_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}gripper_base"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
    </joint>

    <!-- Cuerpo: carcasa, motor, D405 y fisheye (todo en una malla) -->
    <link name="${prefix}gripper_base">
      <visual>
        <origin xyz="0 0 0" rpy="${AGILEX}"/>
        <geometry><mesh filename="${MALLAS}/gripper_base_link.STL"/></geometry>
        <material name="${prefix}pika_dark"/>
      </visual>
      <collision>
        <origin xyz="-0.0335 0 0.0424" rpy="0 0 0"/>
        <geometry><box size="0.143 0.215 0.0848"/></geometry>
      </collision>
      <inertial>
        <origin xyz="-0.00841 0 0.03748" rpy="0 0 0"/>
        <mass value="0.55"/>
        <inertia ixx="0.00032" ixy="-4.9e-08" ixz="7.6e-06" iyy="0.000415" iyz="9.7e-08" izz="0.000626"/>
      </inertial>
    </link>

    <!-- Garras: prismáticas a lo largo de Y. El origen del joint es la garra cerrada; q es la mitad
         de la apertura (caras internas a 2q), como el driver real reparte la apertura total. -->
    <joint name="${prefix}pika_jaw_left_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_jaw_left"/>
      <origin xyz="-0.00642 0.0415 0.0815" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.047" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="${prefix}pika_jaw_left">
      <visual>
        <origin xyz="0 0 0" rpy="${AGILEX}"/>
        <geometry><mesh filename="${MALLAS}/gripper_left_link.STL"/></geometry>
        <material name="${prefix}pika_mid"/>
      </visual>
      <collision>
        <origin xyz="0.00575 -0.013 0.05275" rpy="0 0 0"/>
        <geometry><box size="0.0381 0.057 0.1121"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.00576 -0.01466 0.03326" rpy="0 0 0"/>
        <mass value="0.0337"/>
        <inertia ixx="3.974e-05" ixy="4.4e-09" ixz="-1.5e-08" iyy="3.448e-05" iyz="1.447e-05" izz="1.528e-05"/>
      </inertial>
    </link>

    <joint name="${prefix}pika_jaw_right_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_jaw_right"/>
      <origin xyz="-0.00642 -0.0415 0.0815" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.047" upper="0" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="${prefix}pika_jaw_right">
      <visual>
        <origin xyz="0 0 0" rpy="${AGILEX}"/>
        <geometry><mesh filename="${MALLAS}/gripper_right_link.STL"/></geometry>
        <material name="${prefix}pika_mid"/>
      </visual>
      <collision>
        <origin xyz="0.00575 0.013 0.05275" rpy="0 0 0"/>
        <geometry><box size="0.0381 0.057 0.1121"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0.00581 0.01466 0.03326" rpy="0 0 0"/>
        <mass value="0.0337"/>
        <inertia ixx="3.974e-05" ixy="4.4e-09" ixz="1.5e-08" iyy="3.448e-05" iyz="-1.447e-05" izz="1.528e-05"/>
      </inertial>
    </link>

    <!-- Cámaras: solo marcos (la malla está en el cuerpo). Inercia mínima para que Gazebo no los
         descarte junto con los sensores que cuelgan de ellos. -->
    <joint name="${prefix}pika_depth_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_depth_link"/>
      <origin xyz="-0.0524 0.009 0.0583" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}pika_depth_link">
      <inertial><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
    </link>

    <joint name="${prefix}pika_fisheye_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_fisheye_link"/>
      <origin xyz="-0.0799 0 0.0683" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}pika_fisheye_link">
      <inertial><mass value="0.001"/><inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/></inertial>
    </link>

    <joint name="${prefix}pika_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_tcp"/>
      <origin xyz="-0.00642 0 0.180" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}pika_tcp"/>

  </xacro:macro>

</robot>
