<?xml version="1.0"?>
<!--
  Pika Gripper URDF — Agilex Robotics
  Estructura idéntica al Piper arm (piper_description), con cámaras añadidas.

  Dimensiones de referencia:
    Eje de garras:  0.1358 m desde gripper_base (igual que joint7/joint8 del Piper)
    Apertura máx:   ±35 mm por lado
    Cámara D405:    centrada en X, 46 mm sobre el eje del gripper  → Z = 0.0898 m
    Fisheye (广角): centrada en X, 73.5 mm sobre el eje del gripper → Z = 0.0623 m

  Marco de coordenadas (gripper_base):
    Origen = cara de la brida (interfaz con link6 / parent)
    +Z  : hacia las garras (eje herramienta)
    +X  : apertura de las garras
    +Y  : cara frontal (hacia el espacio de trabajo)

  Visuals activos:
    - gripper_base      : gripper_base.STL (piper_description)
    - pika_jaw_left     : link7.STL        (piper_description)
    - pika_jaw_right    : link8.STL        (piper_description)
    - pika_depth_link   : d405.stl         (realsense2_description)
  Visuals pendientes:
    - pika_fisheye_link : TODO malla real
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="pika_gripper" params="prefix:='' parent origin_xyz:='0 0 0' origin_rpy:='0 0 0'">

    <!-- ── Materiales ────────────────────────────────────────────────── -->
    <material name="${prefix}pika_mid">
      <color rgba="0.55 0.55 0.55 1.0"/>
    </material>
    <material name="${prefix}pika_dark">
      <color rgba="0.18 0.18 0.18 1.0"/>
    </material>
    <material name="${prefix}pika_aluminum">
      <color rgba="0.75 0.75 0.80 1.0"/>
    </material>

    <!-- ── Junta de montaje → gripper_base (= joint6_to_gripper_base del Piper) ── -->
    <joint name="${prefix}pika_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}gripper_base"/>
      <origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
    </joint>

    <!-- gripper_base — mismo STL que el Piper -->
    <link name="${prefix}gripper_base">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://piper_description/meshes/gripper_base.STL"/>
        </geometry>
        <material name="${prefix}pika_mid"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://piper_description/meshes/gripper_base.STL"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.450"/>
        <inertia ixx="9.3e-4" ixy="3.4e-7" ixz="-7.4e-6" iyy="7.1e-4" iyz="5e-8" izz="3.9e-4"/>
      </inertial>
    </link>

    <!-- ══════════════════════════════════════════════════════════════
         GARRAS — idéntico a joint7/joint8 + link7/link8 del Piper
    ══════════════════════════════════════════════════════════════════ -->

    <!-- Garra izquierda (link7) — idéntico a joint7 del Piper -->
    <joint name="${prefix}pika_jaw_left_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_jaw_left"/>
      <origin xyz="0 0 0.1358" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0.035" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="${prefix}pika_jaw_left">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://piper_description/meshes/link7.STL"/>
        </geometry>
        <material name="${prefix}pika_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://piper_description/meshes/link7.STL"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.025"/>
        <inertia ixx="7.4e-5" ixy="-1.1e-6" ixz="2.1e-7" iyy="-1.1e-6" iyz="-1.4e-5" izz="7.5e-5"/>
      </inertial>
    </link>

    <!-- Garra derecha (link8) — idéntico a joint8 del Piper, sin mimic -->
    <joint name="${prefix}pika_jaw_right_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_jaw_right"/>
      <origin xyz="0 0 0.1358" rpy="1.5708 0 -3.1416"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.035" upper="0" effort="10.0" velocity="1.0"/>
    </joint>

    <link name="${prefix}pika_jaw_right">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://piper_description/meshes/link8.STL"/>
        </geometry>
        <material name="${prefix}pika_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://piper_description/meshes/link8.STL"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.025"/>
        <inertia ixx="7.4e-5" ixy="-1.1e-6" ixz="2.1e-7" iyy="-1.1e-6" iyz="-1.4e-5" izz="7.5e-5"/>
      </inertial>
    </link>

    <!-- ── TCP (Tool Center Point) ──────────────────────────────────── -->
    <joint name="${prefix}pika_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child  link="${prefix}pika_tcp"/>
      <origin xyz="0 0 0.185" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}pika_tcp"/>

  </xacro:macro>

</robot>
