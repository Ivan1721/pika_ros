<?xml version="1.0"?>
<!--
  Piper + gripper Pika para Gazebo Classic.
  Reutiliza pika_piper_standalone.urdf.xacro (pika_description) y le agrega
  ros2_control + el plugin gazebo_ros2_control.

  Las mallas usan package://; sim_piper_single.launch.py las convierte a
  file:// antes de pasarlas a Gazebo.
-->
<robot name="pika_piper" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find pika_description)/urdf/pika_piper_standalone.urdf.xacro"/>

  <xacro:macro name="position_joint" params="name initial:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <xacro:position_joint name="joint1"/>
    <xacro:position_joint name="joint2"/>
    <xacro:position_joint name="joint3"/>
    <xacro:position_joint name="joint4"/>
    <xacro:position_joint name="joint5"/>
    <xacro:position_joint name="joint6"/>
    <xacro:position_joint name="pika_jaw_left_joint"/>
    <xacro:position_joint name="pika_jaw_right_joint"/>
  </ros2_control>

  <!-- Colores AgileX en Gazebo (Gazebo Classic no usa los materiales del URDF): base y
       articulaciones negras, brazo y antebrazo grafito, gripper Pika negro mate, cámaras plata -->
  <xacro:macro name="color_gazebo" params="link material">
    <gazebo reference="${link}"><material>${material}</material></gazebo>
  </xacro:macro>
  <xacro:color_gazebo link="base_link" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="link1" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="link2" material="Gazebo/DarkGrey"/>
  <xacro:color_gazebo link="link3" material="Gazebo/DarkGrey"/>
  <xacro:color_gazebo link="link4" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="link5" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="link6" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="gripper_base" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="pika_jaw_left" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="pika_jaw_right" material="Gazebo/FlatBlack"/>
  <xacro:color_gazebo link="pika_depth_link" material="Gazebo/Grey"/>
  <xacro:color_gazebo link="pika_fisheye_link" material="Gazebo/Grey"/>

  <!-- ══════════════════════════════════════════════════════════════
       Cámaras simuladas del gripper Pika, con los topics del hardware real
       (config/single_pika_teleop_data_params.yaml de data_tools):
         /gripper/camera/color/image_raw                  D405 color
         /gripper/camera/aligned_depth_to_color/image_raw D405 profundidad, 16UC1 en mm como el
                                                          driver real (profundidad_mm.py convierte
                                                          los 32FC1 en metros de Gazebo)
         /gripper/camera/depth/color/points               D405 nube de puntos
         /gripper/camera_fisheye/color/image_raw          fisheye
       Supuesto (igual que escena_nbv_demo.py): ambas miran a lo largo de +Z de gripper_base,
       el eje de la herramienta. Las cámaras de Gazebo miran por +X de su link; de ahí el
       giro (0, -π/2, 0). Los marcos ópticos siguen la convención de ROS (Z adelante, X a la
       derecha, Y abajo). Con camaras:=false no se cargan (Gazebo más liviano, p. ej. modo MIT).
  ══════════════════════════════════════════════════════════════════ -->
  <xacro:arg name="camaras" default="true"/>
  <xacro:if value="$(arg camaras)">
    <xacro:property name="PI" value="3.141592653589793"/>

    <xacro:macro name="marco_camara" params="nombre xyz">
      <joint name="${nombre}_joint" type="fixed">
        <parent link="gripper_base"/>
        <child link="${nombre}_link"/>
        <origin xyz="${xyz}" rpy="0 ${-PI/2} 0"/>
      </joint>
      <!-- inercia mínima: Gazebo descarta los links sin masa y con ellos el sensor -->
      <link name="${nombre}_link">
        <inertial>
          <mass value="0.001"/>
          <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
        </inertial>
      </link>
      <joint name="${nombre}_optical_joint" type="fixed">
        <parent link="${nombre}_link"/>
        <child link="${nombre}_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
      </joint>
      <link name="${nombre}_optical_frame"/>
    </xacro:macro>

    <!-- D405: frente del módulo, 12 mm por delante del centro de pika_depth_link -->
    <xacro:marco_camara nombre="pika_d405" xyz="-0.046 0 0.039"/>
    <!-- Fisheye: frente del lente, sobre pika_fisheye_link -->
    <xacro:marco_camara nombre="pika_fisheye_cam" xyz="-0.0735 0 0.047"/>

    <!-- D405: 87° × 58°, 7–50 cm de rango útil; 640×480 a 30 Hz como start_single_gripper.bash -->
    <gazebo reference="pika_d405_link">
      <sensor type="depth" name="pika_d405">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.518</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>1.5</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
        </camera>
        <plugin name="pika_d405_driver" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>gripper</namespace>
            <remapping>camera/image_raw:=camera/color/image_raw</remapping>
            <remapping>camera/camera_info:=camera/color/camera_info</remapping>
            <remapping>camera/depth/image_raw:=camera/depth_sim/image_raw</remapping>
            <remapping>camera/depth/camera_info:=camera/aligned_depth_to_color/camera_info</remapping>
            <remapping>camera/points:=camera/depth/color/points</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>pika_d405_optical_frame</frame_name>
          <min_depth>0.07</min_depth>
          <max_depth>0.5</max_depth>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Fisheye WN-L712V11 (200° en diagonal): lente equidistante de Gazebo, 180° en horizontal -->
    <gazebo reference="pika_fisheye_cam_link">
      <sensor type="wideanglecamera" name="pika_fisheye">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>3.1416</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>20</far></clip>
          <lens>
            <type>equidistant</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.75</cutoff_angle>
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name="pika_fisheye_driver" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>gripper</namespace>
            <remapping>camera_fisheye/image_raw:=camera_fisheye/color/image_raw</remapping>
            <remapping>camera_fisheye/camera_info:=camera_fisheye/color/camera_info</remapping>
          </ros>
          <camera_name>camera_fisheye</camera_name>
          <frame_name>pika_fisheye_cam_optical_frame</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find pika_sim)/config/pika_piper_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
